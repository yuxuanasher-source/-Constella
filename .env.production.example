# 经营舱 生产环境变量模板（部署到腾讯云轻量服务器）
# 用法：复制为 .env.local 后填入真实值。.env.local 不会进入 git。
#
#   cp .env.production.example .env.local
#
# 注意：以 NEXT_PUBLIC_ 开头的变量会被打包进前端，浏览器可见，不要放密钥。
# build（pnpm build）之前这些变量就要存在，否则构建会用错值。

# ── Supabase（自建 self-host 的对外网关地址）──────────────────────────
# 必须是浏览器能直接访问的公网地址（登录/鉴权在前端发起），用子域名 + HTTPS。
# 指向你 Nginx 反代到 Supabase Kong 网关(127.0.0.1:8000) 的子域名。
NEXT_PUBLIC_SUPABASE_URL=https://api.your-domain.com

# 自建 Supabase 的 anon key（在 Supabase 的 docker .env 里用 JWT_SECRET 生成）
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-self-host-anon-key

# service_role key（服务端用，权限极高，绝不能带 NEXT_PUBLIC_ 前缀、绝不暴露给前端）
SUPABASE_SERVICE_ROLE_KEY=replace-with-self-host-service-role-key

# ── 应用自身 ──────────────────────────────────────────────────────────
# 你的站点对外地址，用于回调/邮件链接等，必须和真实访问地址一致
NEXT_PUBLIC_APP_URL=https://app.your-domain.com

# 私有存储桶名称（代码默认 jy-private；要先在 Supabase Storage 里建好这个桶）
SUPABASE_PRIVATE_BUCKET=jy-private

# ── 可选：腾讯云 OCR（AI/证件识别功能用到，不用可留空）──────────────────
# TENCENT_SECRET_ID=
# TENCENT_SECRET_KEY=
