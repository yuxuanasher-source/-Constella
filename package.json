{
  "name": "jingying-cabin",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "check:changed-format": "node scripts/check-changed-format.mjs",
    "test:critical-coverage": "vitest run lib/markdown features/billing/providers features/billing/webhooks.test.ts features/billing/usage-metering.test.ts features/ai/knowledge-base.test.ts --coverage",
    "check:bundle-budget": "node scripts/check-bundle-budget.mjs",
    "start": "next start",
    "lint": "eslint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:api-contracts": "vitest run app/api/api-route-contracts.test.ts",
    "test:ci-contracts": "vitest run scripts/ci-workflow-contract.test.ts",
    "test:api-integration-smoke": "node scripts/api-integration-smoke.mjs",
    "test:manual-acceptance-smoke": "node scripts/manual-acceptance-smoke.mjs",
    "test:ai-performance": "vitest run features/ai/hermes/performance-statistics.test.ts features/ai/hermes/performance-contract.test.ts",
    "test:ai-resilience": "vitest run scripts/test-ai-conversation-resilience.test.mjs && node scripts/test-ai-conversation-resilience.mjs",
    "test:deploy-contract": "node --test scripts/deploy-contract.test.mjs",
    "verify:xingyao-hermes-release": "node scripts/verify-xingyao-hermes-release.mjs",
    "test:xingyao-hermes-e2e": "node scripts/test-xingyao-hermes-e2e.mjs --local",
    "test:ops-visual": "playwright test tests/visual/arco-redesign.spec.ts",
    "test:organization-brand-share": "playwright test --config=playwright.task11.config.ts",
    "platform-admin:grant": "node scripts/grant-platform-admin.mjs",
    "test:dto-contracts": "vitest run features/dto-contracts/api-dto-contract.test.ts",
    "test:golden": "vitest run features/regression/settlement-golden-path.test.ts",
    "test:p3-governance": "vitest run features/audit-center features/notifications features/anomalies features/exports features/regression/governance-golden-path.test.ts",
    "test:p4-flywheel": "vitest run features/auto-review app/api/auto-review features/war-room app/api/war-room features/ai app/api/ai features/regression/p4-flywheel.test.ts",
    "test:p5-commercialization": "vitest run lib/db/p5-schema-contract.test.ts features/billing app/api/billing features/regression/p5-commercialization.test.ts",
    "test:p6-payment": "vitest run lib/db/p6-schema-contract.test.ts features/billing features/regression/p6-payment.test.ts",
    "test:onboarding-funnel": "vitest run lib/db/funnel-schema-contract.test.ts features/funnel features/regression/onboarding-funnel.test.ts",
    "test:async-tasks": "vitest run lib/db/async-task-schema-contract.test.ts features/async-tasks",
    "test:ai-system": "vitest run lib/db/ai-schema-contract.test.ts lib/db/xingyao-hermes-native-schema-contract.test.ts features/ai app/api/ai app/api/ocr",
    "test:permissions": "vitest run features/live-operations/live-operations-service.test.ts features/settlements/settlement-service.test.ts",
    "test:custom-settlement": "vitest run features/settlements app/api/settlement-batches features/regression/custom-settlement-rules-golden-path.test.ts features/regression/custom-settlement-cost-reconciliation.test.ts",
    "test:ui-smoke": "vitest run components/reference-ui/ops-reference.test.jsx components/reference-ui/ops-reference-org-members.test.jsx components/reference-ui/streamer-mobile-reference.test.jsx",
    "audit:security": "pnpm audit --audit-level moderate",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:migrate": "supabase db reset",
    "supabase:seed": "supabase db reset"
  },
  "dependencies": {
    "@arco-design/web-react": "^2.66.16",
    "@heroui/react": "^3.2.1",
    "@jsep-plugin/object": "1.2.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cos-nodejs-sdk-v5": "3.0.0",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.41.0",
    "jose": "^6.2.3",
    "jsep": "1.4.0",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "pdf-lib": "^1.17.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.35.0",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.1",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "4.1.8",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "supabase": "^2.103.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
