NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
STORAGE_BUCKET_PRIVATE=jy-private

SMOKE_PROJECT_ID=
SMOKE_STREAMER_ID=
SMOKE_OWNER_EMAIL=
SMOKE_OPS_EMAIL=
SMOKE_FINANCE_EMAIL=
SMOKE_STREAMER_EMAIL=
SMOKE_USER_PASSWORD=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
HUNYUAN_API_KEY=
HUNYUAN_BASE_URL=https://api.hunyuan.cloud.tencent.com
HUNYUAN_MODEL=hunyuan-turbos-latest
# DeepSeek（OpenAI 兼容）：只需填 DEEPSEEK_API_KEY；base/model 有默认值。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
AI_PRIMARY_PROVIDER=deepseek
AI_SHADOW_PROVIDER=hunyuan
# AI provider（DeepSeek/混元/OpenAI/腾讯 OCR）单次 fetch 超时，毫秒，默认 30000。
# 非流式：覆盖整个请求；流式：按空闲超时计算（每收到一个 chunk 重置计时）。
# 超时会被网关的 fallback 捕获并切换到下一个 provider。
AI_PROVIDER_TIMEOUT_MS=30000
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_OCR_REGION=ap-guangzhou
TENCENT_OCR_SMOKE_IMAGE_BASE64=

# 豆包（火山引擎）大模型录音文件识别·极速版：录屏 AI 分析的语音转文字环节。
# App ID / Access Token 来自火山引擎控制台「语音技术-大模型录音文件识别」。
# 未配置时录屏分析自动回退确定性草稿，不报错。
DOUBAO_ASR_APP_KEY=
DOUBAO_ASR_ACCESS_KEY=
# 以下均有默认值，按需覆盖。
DOUBAO_ASR_BASE_URL=https://openspeech.bytedance.com
DOUBAO_ASR_RESOURCE_ID=volc.bigasr.auc_turbo
DOUBAO_ASR_MODEL=bigmodel
# 长录音转写较慢，默认 120000（120s）。
DOUBAO_ASR_TIMEOUT_MS=120000
# 录屏抽音频用的 ffmpeg 二进制，默认取 PATH 中的 ffmpeg。
RECORDING_AI_FFMPEG_PATH=

# 腾讯云 COS 对象存储（知识库持久化）。复用上面的 TENCENT_SECRET_ID/KEY，
# 桶名/地域默认即下列值（代码内置），只要密钥就绪即自动启用；如需切换桶再覆盖。
TENCENT_COS_BUCKET=jy-private-1322741645
TENCENT_COS_REGION=ap-guangzhou
# TENCENT_COS_SECRET_ID=
# TENCENT_COS_SECRET_KEY=

OCR_RUNNER_TOKEN=
OCR_RUNNER_ORGANIZATION_ID=
OCR_RUNNER_USER_ID=
OCR_RUNNER_USER_NAME=OCR Runner
RECORDING_AI_RUNNER_TOKEN=
RECORDING_AI_RUNNER_ORGANIZATION_ID=
RECORDING_AI_RUNNER_USER_ID=
RECORDING_AI_RUNNER_USER_NAME=Recording AI Runner
# 异常扫描定时任务（外部调度器以 Bearer token 调用 /api/internal/anomalies/run）。
# TOKEN 为 runner 鉴权密钥；ORGANIZATION_ID / USER_ID 为扫描使用的系统身份（UUID）。
ANOMALY_RUNNER_TOKEN=
ANOMALY_RUNNER_ORGANIZATION_ID=
ANOMALY_RUNNER_USER_ID=
ANOMALY_RUNNER_USER_NAME=Anomaly Runner
# 账号库定时任务（闲置扫描 /api/internal/account-library/idle-scan/run、
# 指标同步 /api/internal/account-library/metrics-sync/run）。
ACCOUNT_LIBRARY_RUNNER_TOKEN=
ACCOUNT_LIBRARY_RUNNER_ORGANIZATION_ID=
ACCOUNT_LIBRARY_RUNNER_USER_ID=
ACCOUNT_LIBRARY_RUNNER_USER_NAME=Account Library Runner
# 平台开放接口网关（拉取模式指标同步）：POST {platform, accountUid}，
# 返回 {metricDate, followerCount, liveViewCount, gmvAmount, liveDurationMinutes}。
PLATFORM_METRICS_ENDPOINT=
PLATFORM_METRICS_TOKEN=
# 上播审核自学习任务（厂家备注归一化 /api/internal/admission-review/classify/run，
# AI 预审 /api/internal/admission-review/pre-review/run，
# 校准指标 /api/internal/admission-review/metrics/run，
# 结果回流 /api/internal/admission-review/outcome/run）。
ADMISSION_RUNNER_TOKEN=
ADMISSION_RUNNER_ORGANIZATION_ID=
ADMISSION_RUNNER_USER_ID=
ADMISSION_RUNNER_USER_NAME=Admission Runner

# P6 支付：聚合支付 provider（默认 mock；持牌渠道签约后替换）
BILLING_PAYMENT_PROVIDER=mock
# mock provider 回调验签密钥（HMAC-SHA256），生产替换为渠道密钥
BILLING_MOCK_WEBHOOK_SECRET=mock-secret
# 计费定时任务触发密钥（外部调度器以 x-cron-secret 头调用 /api/billing/jobs/*）
BILLING_CRON_SECRET=replace-with-cron-secret
