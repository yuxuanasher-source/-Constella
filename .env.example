NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
STORAGE_BUCKET_PRIVATE=jy-private

# DeepSeek LLM 适配器（features/ai/providers/deepseek-provider.ts）
# 未配置 DEEPSEEK_API_KEY 时 Provider 返回 degraded，不影响确定性主链路。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
